# Copy to .env and fill in. Never commit .env.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/impostor
JWT_SECRET=change-me-to-a-long-random-string

# Where links in emails point (the web app)
APP_URL=https://hammrti.me

# Email (Brevo free tier: brevo.com > SMTP & API > API keys).
# Leave BREVO_API_KEY empty locally and emails print to the console instead.
BREVO_API_KEY=
EMAIL_FROM=noreply@hammrti.me
EMAIL_FROM_NAME=Impostor
